GROQ_API_KEY=your_key_here

# Optional overrides (defaults live in src/config/constants.py)
# AGENT_MODEL_NAME=qwen/qwen3.8-27b
# API_HOST=127.0.0.1
# API_PORT=8000
# DASHBOARD_PORT=8501
# LOG_LEVEL=INFO
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Scheduled report generation (off by default). If enabled, the API
# process writes docs/sample_weekly_report.md on this interval.
# REPORT_SCHEDULE_ENABLED=false
# REPORT_SCHEDULE_INTERVAL_SECONDS=604800
# REPORT_SCHEDULE_RUN_ON_STARTUP=true

# Token-usage cost estimate on the dashboard's Usage tab (optional).
# Set both to your actual Groq plan rates to see a $ estimate there.
# COST_PER_1K_PROMPT_TOKENS=0
# COST_PER_1K_COMPLETION_TOKENS=0

# What the reviewed items are called in dashboard tooltips (e.g. "beauty product").
# DATASET_ITEM_LABEL=grocery item
